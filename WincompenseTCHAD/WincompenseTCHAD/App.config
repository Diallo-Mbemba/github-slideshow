<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <!--
    Chaîne de connexion vers SQL Server Express (base GWC_WINCOMPENSE_ETD).
    Authentification Windows intégrée par défaut - À CONFIRMER / adapter selon l'environnement
    de production (authentification SQL avec utilisateur dédié, par exemple).
  -->
  <connectionStrings>
    <add name="GWC_WINCOMPENSE_ETD"
         connectionString="Server=.\SQLEXPRESS;Database=GWC_WINCOMPENSE_ETD;Integrated Security=True;Connect Timeout=10;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
